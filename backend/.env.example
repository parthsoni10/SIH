# ==============================================================================
# AI Border Identity Screening System — Backend Environment Sample (.env.example)
# Copy this file to .env and fill in your GEMINI_API_KEY
# ==============================================================================

# Application Meta
PROJECT_NAME="AI-Based Fake Identity & Document Screening System"

# Mistral AI API Key (Get key from Mistral Console: https://console.mistral.ai/)
MISTRAL_API_KEY="your_mistral_api_key_here"

# Database & Storage Settings
DATABASE_URL="sqlite:///screening.db"
UPLOAD_DIR="uploads"
MAX_IMAGE_EDGE=2000

# Model Paths
RISK_MODEL_PATH="app/models/risk_model.pkl"
